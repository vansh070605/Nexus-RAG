{
    "version": 2,
    "name": "nexus-rag",
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/**/*",
            "use": "@vercel/static"
        }
    ],
    "rewrites": [
        {
            "source": "/upload",
            "destination": "/app.py"
        },
        {
            "source": "/ask",
            "destination": "/app.py"
        },
        {
            "source": "/css/(.*)",
            "destination": "/frontend/css/$1"
        },
        {
            "source": "/js/(.*)",
            "destination": "/frontend/js/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/index.html"
        }
    ]
}