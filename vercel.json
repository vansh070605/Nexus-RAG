{
    "version": 2,
    "name": "nexus-rag",

    "rewrites": [
        {
            "source": "/upload",
            "destination": "/app.py"
        },
        {
            "source": "/ask",
            "destination": "/app.py"
        },
        {
            "source": "/css/(.*)",
            "destination": "/frontend/css/$1"
        },
        {
            "source": "/js/(.*)",
            "destination": "/frontend/js/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/index.html"
        }
    ]
}